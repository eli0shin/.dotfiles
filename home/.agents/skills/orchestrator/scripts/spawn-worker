#!/usr/bin/env bash

set -o pipefail

usage() {
  echo "Usage: spawn-worker [--repo <path>] [--model <name>] <ticket-name> [--context <text>]" >&2
  echo "       spawn-worker [--repo <path>] [--model <name>] --branch <branch-name> [--task <text>]" >&2
  echo "       spawn-worker --list-models" >&2
  exit 2
}

# Worker models come from the "worker" role in Pi's roles.json, which dot merge
# generates from roles.base.json and its profile layers. "default" is the
# provider/model ID every worker runs; "eligible" lists the IDs --model may
# name, and the default is always eligible. A model's name is its ID without
# the provider.
#
# `worker_models --list` prints every eligible name, marking the default.
# `worker_models` prints the default ID, or nothing without one.
# `worker_models <name>` prints the one eligible ID with that name.
worker_models() {
  python3 -c '
import json, os, sys
path = os.path.join(os.path.expanduser(os.environ.get("PI_CODING_AGENT_DIR") or "~/.pi/agent"), "roles.json")
try:
    with open(path) as f:
        role = json.load(f).get("worker") or {}
except FileNotFoundError:
    role = {}
except ValueError as error:
    sys.exit("spawn-worker: invalid %s: %s" % (path, error))
default = role.get("default") or ""
models = list(dict.fromkeys(([default] if default else []) + list(role.get("eligible") or [])))
name_of = lambda model: model.partition("/")[2] or model
if len(sys.argv) == 1:
    print(default)
elif sys.argv[1] == "--list":
    for model in models:
        print(name_of(model) + (" (default)" if model == default else ""))
else:
    name = sys.argv[1]
    matches = [model for model in models if name_of(model) == name]
    if len(matches) == 1:
        print(matches[0])
    elif matches:
        sys.exit("spawn-worker --model %s matches more than one eligible model: %s" % (name, ", ".join(matches)))
    else:
        names = ", ".join(map(name_of, models)) or "none"
        sys.exit("spawn-worker --model %s is not an eligible worker model; eligible: %s" % (name, names))
' "$@"
}

if [[ $# -eq 1 && $1 == --list-models ]]; then
  worker_models --list
  exit
fi

# --repo names the checkout the worker stacks on; it defaults to the current
# directory. Its checked-out branch is the worker's landing branch.
# --model names an eligible model without its provider.
repo=""
model=""
args=()
while [[ $# -gt 0 ]]; do
  if [[ $1 == --repo ]]; then
    if [[ $# -lt 2 || -z $2 || -n $repo ]]; then
      usage
    fi
    repo=$2
    shift 2
  elif [[ $1 == --model ]]; then
    if [[ $# -lt 2 || -z $2 || $2 == -* || -n $model ]]; then
      usage
    fi
    model=$2
    shift 2
  else
    args+=("$1")
    shift
  fi
done
set -- "${args[@]}"

# A ticket handoff names a tracker ticket, which is also the branch; its text
# is optional steering. A task handoff has no ticket, so its text is the task.
if [[ ${1:-} == --branch ]]; then
  if [[ $# -ne 2 && $# -ne 4 ]] || [[ $# -eq 4 && $3 != "--task" ]]; then
    usage
  fi
  ticket=""
  branch=$2
  text_arg_position=4
else
  if [[ $# -ne 1 && $# -ne 3 ]] || [[ $# -eq 3 && $2 != "--context" ]]; then
    usage
  fi
  ticket=$1
  branch=$1
  text_arg_position=3
fi
if [[ -z $branch || $branch == -* ]]; then
  usage
fi
# Without its flag, the text comes from piped stdin.
text=""
if [[ $# -eq $text_arg_position ]]; then
  text=${!text_arg_position}
elif [[ ! -t 0 ]]; then
  text=$(cat)
fi
shopt -s extglob
text=${text##+([[:space:]])}
text=${text%%+([[:space:]])}
if [[ -z $ticket && -z $text ]]; then
  echo "spawn-worker --branch requires a task from --task or stdin" >&2
  exit 2
fi

if [[ -n $repo ]] && ! cd -- "$repo"; then
  echo "spawn-worker --repo requires an existing checkout: $repo" >&2
  exit 2
fi

if [[ -n ${OPENCODE_ORCHESTRATION_SESSION_ID:-} ]]; then
  orchestration_session_id=$OPENCODE_ORCHESTRATION_SESSION_ID
  orchestration_harness=opencode
elif [[ -n ${PI_ORCHESTRATION_SESSION_ID:-} ]]; then
  orchestration_session_id=$PI_ORCHESTRATION_SESSION_ID
  orchestration_harness=pi
else
  echo "spawn-worker requires OPENCODE_ORCHESTRATION_SESSION_ID or PI_ORCHESTRATION_SESSION_ID" >&2
  exit 2
fi

# Resolve the worker's model: the eligible model --model names, else the default.
model_id=""
if [[ $orchestration_harness == opencode ]]; then
  if [[ -n $model ]]; then
    echo "spawn-worker --model supports only Pi workers; OpenCode cannot choose a model at launch" >&2
    exit 2
  fi
else
  model_id=$(worker_models ${model:+"$model"}) || exit 2
fi

if ! landing_branch=$(git branch --show-current 2>/dev/null) || [[ -z $landing_branch ]]; then
  echo "spawn-worker requires a named current Git branch" >&2
  exit 2
fi

if ! upstream=$(git rev-parse --abbrev-ref --symbolic-full-name '@{upstream}' 2>/dev/null) ||
  [[ $upstream != */* || ${upstream#*/} != "$landing_branch" ]]; then
  echo "spawn-worker requires landing branch $landing_branch to track a same-named remote branch" >&2
  exit 2
fi

head_sha=$(git rev-parse HEAD 2>/dev/null) || exit
upstream_sha=$(git rev-parse '@{upstream}' 2>/dev/null) || exit
if [[ $head_sha != "$upstream_sha" ]]; then
  echo "spawn-worker requires landing branch $landing_branch to exactly match its upstream" >&2
  exit 2
fi

if [[ -n $ticket ]]; then
  tickets show "$ticket" || exit
fi

# The window over herdr-core is Herdr app (herdr-app), or herdr-frontend when
# ~/.config/herdr/frontend says so; missing or unreadable means herdr-app.
# Both CLIs take the same ls and do arguments and print the same JSON.
frontend=herdr-app
if [[ $(cat -- "${XDG_CONFIG_HOME:-$HOME/.config}/herdr/frontend" 2>/dev/null) =~ ^[[:space:]]*herdr-frontend[[:space:]]*$ ]]; then
  frontend=herdr-frontend
fi

# herdr-core also runs terminals on machines the app reaches over SSH, with
# the same markers, so this computer's open window must show this terminal.
herdr_app_shows_terminal() {
  [[ -n ${HC_TERMINAL_ID:-} ]] && command -v "$frontend" >/dev/null &&
    "$frontend" ls 2>/dev/null | python3 -c '
import json, sys
terminal = sys.argv[1]
shown = any(
    not space.get("machine") and terminal in (t["terminal"] for tab in space["tabs"] for t in tab["terminals"])
    for space in json.load(sys.stdin)["spaces"]
)
sys.exit(0 if shown else 1)
' "$HC_TERMINAL_ID" 2>/dev/null
}

# The innermost manager wins: legacy Herdr, then tmux, then the Herdr app.
# workspace_manager=herdr-app means either frontend's window ($frontend).
# Under the Herdr app, repos creates only the worktree (--no-tmux) and this
# script opens the worker's space; `repos clean` later closes it by its folder.
workspace_manager=tmux
if [[ ${HERDR_ENV:-} == 1 ]]; then
  workspace_manager=herdr
elif [[ -z ${TMUX:-} ]] && herdr_app_shows_terminal; then
  workspace_manager=herdr-app
fi
repos_flag=--no-focus
if [[ $workspace_manager == herdr-app ]]; then
  repos_flag=--no-tmux
fi

# An existing branch or worktree means the worker is being recovered: reuse it
# with `repos work`, which also reuses or creates its Managed Workspace.
# repos prints the worktree path as the last line of stdout.
remote=${upstream%%/*}
if git show-ref --verify --quiet "refs/heads/$branch" ||
  git ls-remote --exit-code --heads "$remote" "refs/heads/$branch" >/dev/null 2>&1; then
  repos_command=work
else
  repos_command=stack
fi
if [[ $workspace_manager == herdr-app ]]; then
  repos_output=$(repos "$repos_command" "$repos_flag" "$branch") || exit
  worktree=${repos_output##*$'\n'}
  if [[ ! -d $worktree ]]; then
    echo "repos did not print the worktree path for $branch" >&2
    exit 1
  fi
else
  repos "$repos_command" "$repos_flag" "$branch" || exit
fi

# repos names the workspace <repo>@<branch>, with "/" in the branch as "-".
common_dir=$(git rev-parse --path-format=absolute --git-common-dir) || exit
repo_name=$(basename "$(dirname "$common_dir")")
worker_identity="$repo_name@${branch//\//-}"

if [[ $workspace_manager == herdr ]]; then
  pane_id=$(python3 -c '
import json, subprocess, sys
label = sys.argv[1]
herdr = lambda *args: json.loads(subprocess.check_output(["herdr", *args]))["result"]
ids = [w["workspace_id"] for w in herdr("workspace", "list")["workspaces"] if w["label"] == label]
if len(ids) != 1:
    raise SystemExit(f"expected one Managed Workspace labeled {label}, found {len(ids)}")
panes = [p["pane_id"] for p in herdr("pane", "list")["panes"] if p["workspace_id"] == ids[0]]
if not panes:
    raise SystemExit(f"no pane in Managed Workspace {label}")
print(panes[0])
' "$worker_identity") || exit
elif [[ $workspace_manager == herdr-app ]]; then
  # A recovered worker reuses its space; otherwise it gets a new one.
  space_id=$("$frontend" ls | python3 -c '
import json, sys
label = sys.argv[1]
ids = [s["id"] for s in json.load(sys.stdin)["spaces"] if s["name"] == label and not s.get("machine")]
if len(ids) > 1:
    raise SystemExit(f"expected at most one Herdr space named {label}, found {len(ids)}")
print(ids[0] if ids else "")
' "$worker_identity") || exit
elif ! tmux has-session -t "=$worker_identity:" 2>/dev/null; then
  echo "repos did not create worker session $worker_identity for $branch" >&2
  exit 1
fi

if [[ -n $ticket ]]; then
  printf -v prompt '%s \n\nTicket: %s\nWorker identity: %s\nPR base: %s' \
    '/skill:ticket-worker' "$ticket" "$worker_identity" "$landing_branch"
  if [[ -n $text ]]; then
    printf -v prompt '%s\n\nContext:\n%s' "$prompt" "$text"
  fi
else
  printf -v prompt '%s \n\nBranch: %s\nWorker identity: %s\nPR base: %s\n\nTask:\n%s' \
    '/skill:ticket-worker' "$branch" "$worker_identity" "$landing_branch" "$text"
fi

# A new pane can still have canonical terminal input enabled. Long commands
# can overflow that input buffer, including the final Enter. Send only a path.
# mktemp creates a private file; /tmp keeps the command short and shell-neutral.
launcher=$(mktemp /tmp/pi-worker.XXXXXXXXXX) || exit
if ! {
  printf '%s\n' 'rm -- "$0" || exit'
  if [[ $orchestration_harness == opencode ]]; then
    printf '%s\n' 'unset OPENCODE_ORCHESTRATION_SESSION_ID OPENCODE_PARENT_ORCHESTRATION_SESSION_ID PI_ORCHESTRATION_SESSION_ID PI_PARENT_ORCHESTRATION_SESSION_ID'
    printf 'export OPENCODE_PARENT_ORCHESTRATION_SESSION_ID=%q\n' "$orchestration_session_id"
    printf 'exec opencode --standalone --prompt %q\n' "$prompt"
  else
    printf '%s\n' 'unset OPENCODE_ORCHESTRATION_SESSION_ID OPENCODE_PARENT_ORCHESTRATION_SESSION_ID PI_ORCHESTRATION_SESSION_ID PI_PARENT_ORCHESTRATION_SESSION_ID'
    printf 'export PI_PARENT_ORCHESTRATION_SESSION_ID=%q\n' "$orchestration_session_id"
    if [[ -n $model_id ]]; then
      printf 'exec pi --model %q %q\n' "$model_id" "$prompt"
    else
      printf 'exec pi %q\n' "$prompt"
    fi
  fi
} > "$launcher"; then
  rm -f -- "$launcher"
  exit 1
fi

# The pane owns the file after dispatch. It removes the file before starting Pi.
command="bash $launcher"
if [[ $workspace_manager == herdr ]]; then
  herdr pane run "$pane_id" "$command"
  launch_status=$?
elif [[ $workspace_manager == herdr-app ]]; then
  # space.new and tab.new always focus what they open (herdr-app#447). A core
  # terminal labeled with a space and tab id shows up there without focus; an
  # id the app doesn't know becomes a new space or tab. Like the app, run the
  # agent in a login shell that stays open after it exits. Tabs start unnamed:
  # Pi's auto-session-name extension names them after the session.
  new_id() { python3 -c 'import uuid; print(uuid.uuid4().hex)'; }
  new_space=
  if [[ -z $space_id ]]; then
    space_id=sp$(new_id) || exit
    new_space=1
  fi
  tab_id=tb$(new_id) || exit
  shell=${SHELL:-/bin/bash}
  if [[ ${shell##*/} == fish ]]; then
    run_argv=("$shell" -lic 'command $argv[2..]; exec $argv[1] -li' "$shell" bash "$launcher")
  else
    run_argv=("$shell" -lic 'bash "$1"; exec "$0" -li' "$shell" "$launcher")
  fi
  hc run --bg --keep --no-parent --cwd "$worktree" \
    --label "herdr.space=$space_id" --label "herdr.tab=$tab_id" \
    -- "${run_argv[@]}" >&2
  launch_status=$?
  # A new space is unnamed until the app adopts the terminal; then give it the
  # worker identity, which recovery and repos match.
  if [[ $launch_status -eq 0 && -n $new_space ]]; then
    renamed=
    for _ in {1..50}; do
      if "$frontend" ls | python3 -c '
import json, sys
sys.exit(0 if any(s["id"] == sys.argv[1] for s in json.load(sys.stdin)["spaces"]) else 1)
' "$space_id" 2>/dev/null; then
        "$frontend" do space.rename --id "$space_id" --name "$worker_identity" >/dev/null && renamed=1
        break
      fi
      sleep 0.1
    done
    if [[ -z $renamed ]]; then
      echo "spawn-worker: launched $worker_identity but could not name its space $space_id" >&2
    fi
  fi
else
  tmux send-keys -l -t "$worker_identity:0" -- "$command" &&
    tmux send-keys -t "$worker_identity:0" Enter
  launch_status=$?
fi
if [[ $launch_status -ne 0 ]]; then
  rm -f -- "$launcher"
fi
exit "$launch_status"
