#!/usr/bin/env bash

set -o pipefail

usage() {
  echo "Usage: spawn-worker [--repo <path>] <ticket-name> [--context <text>]" >&2
  echo "       spawn-worker [--repo <path>] --branch <branch-name> [--task <text>]" >&2
  exit 2
}

# --repo names the checkout the worker stacks on; it defaults to the current
# directory. Its checked-out branch is the worker's landing branch.
repo=""
args=()
while [[ $# -gt 0 ]]; do
  if [[ $1 == --repo ]]; then
    if [[ $# -lt 2 || -z $2 || -n $repo ]]; then
      usage
    fi
    repo=$2
    shift 2
  else
    args+=("$1")
    shift
  fi
done
set -- "${args[@]}"

# A ticket handoff names a tracker ticket, which is also the branch; its text
# is optional steering. A task handoff has no ticket, so its text is the task.
if [[ ${1:-} == --branch ]]; then
  if [[ $# -ne 2 && $# -ne 4 ]] || [[ $# -eq 4 && $3 != "--task" ]]; then
    usage
  fi
  ticket=""
  branch=$2
  text_arg_position=4
else
  if [[ $# -ne 1 && $# -ne 3 ]] || [[ $# -eq 3 && $2 != "--context" ]]; then
    usage
  fi
  ticket=$1
  branch=$1
  text_arg_position=3
fi
if [[ -z $branch || $branch == -* ]]; then
  usage
fi
# Without its flag, the text comes from piped stdin.
text=""
if [[ $# -eq $text_arg_position ]]; then
  text=${!text_arg_position}
elif [[ ! -t 0 ]]; then
  text=$(cat)
fi
shopt -s extglob
text=${text##+([[:space:]])}
text=${text%%+([[:space:]])}
if [[ -z $ticket && -z $text ]]; then
  echo "spawn-worker --branch requires a task from --task or stdin" >&2
  exit 2
fi

if [[ -n $repo ]] && ! cd -- "$repo"; then
  echo "spawn-worker --repo requires an existing checkout: $repo" >&2
  exit 2
fi

if [[ -n ${OPENCODE_ORCHESTRATION_SESSION_ID:-} ]]; then
  orchestration_session_id=$OPENCODE_ORCHESTRATION_SESSION_ID
  orchestration_harness=opencode
elif [[ -n ${PI_ORCHESTRATION_SESSION_ID:-} ]]; then
  orchestration_session_id=$PI_ORCHESTRATION_SESSION_ID
  orchestration_harness=pi
else
  echo "spawn-worker requires OPENCODE_ORCHESTRATION_SESSION_ID or PI_ORCHESTRATION_SESSION_ID" >&2
  exit 2
fi

if ! landing_branch=$(git branch --show-current 2>/dev/null) || [[ -z $landing_branch ]]; then
  echo "spawn-worker requires a named current Git branch" >&2
  exit 2
fi

if ! upstream=$(git rev-parse --abbrev-ref --symbolic-full-name '@{upstream}' 2>/dev/null) ||
  [[ $upstream != */* || ${upstream#*/} != "$landing_branch" ]]; then
  echo "spawn-worker requires landing branch $landing_branch to track a same-named remote branch" >&2
  exit 2
fi

head_sha=$(git rev-parse HEAD 2>/dev/null) || exit
upstream_sha=$(git rev-parse '@{upstream}' 2>/dev/null) || exit
if [[ $head_sha != "$upstream_sha" ]]; then
  echo "spawn-worker requires landing branch $landing_branch to exactly match its upstream" >&2
  exit 2
fi

if [[ -n $ticket ]]; then
  tickets show "$ticket" || exit
fi

workspace_manager=tmux
if [[ ${HERDR_ENV:-} == 1 ]]; then
  workspace_manager=herdr
fi

# An existing branch or worktree means the worker is being recovered: reuse it
# with `repos work`, which also reuses or creates its Managed Workspace.
remote=${upstream%%/*}
if git show-ref --verify --quiet "refs/heads/$branch" ||
  git ls-remote --exit-code --heads "$remote" "refs/heads/$branch" >/dev/null 2>&1; then
  repos work --no-focus "$branch" || exit
else
  repos stack --no-focus "$branch" || exit
fi

# repos names the workspace <repo>@<branch>, with "/" in the branch as "-".
common_dir=$(git rev-parse --path-format=absolute --git-common-dir) || exit
repo_name=$(basename "$(dirname "$common_dir")")
worker_identity="$repo_name@${branch//\//-}"

if [[ $workspace_manager == herdr ]]; then
  pane_id=$(python3 -c '
import json, subprocess, sys
label = sys.argv[1]
herdr = lambda *args: json.loads(subprocess.check_output(["herdr", *args]))["result"]
ids = [w["workspace_id"] for w in herdr("workspace", "list")["workspaces"] if w["label"] == label]
if len(ids) != 1:
    raise SystemExit(f"expected one Managed Workspace labeled {label}, found {len(ids)}")
panes = [p["pane_id"] for p in herdr("pane", "list")["panes"] if p["workspace_id"] == ids[0]]
if not panes:
    raise SystemExit(f"no pane in Managed Workspace {label}")
print(panes[0])
' "$worker_identity") || exit
elif ! tmux has-session -t "=$worker_identity:" 2>/dev/null; then
  echo "repos did not create worker session $worker_identity for $branch" >&2
  exit 1
fi

if [[ -n $ticket ]]; then
  printf -v prompt '%s \n\nTicket: %s\nWorker identity: %s\nPR base: %s' \
    '/skill:ticket-worker' "$ticket" "$worker_identity" "$landing_branch"
  if [[ -n $text ]]; then
    printf -v prompt '%s\n\nContext:\n%s' "$prompt" "$text"
  fi
else
  printf -v prompt '%s \n\nBranch: %s\nWorker identity: %s\nPR base: %s\n\nTask:\n%s' \
    '/skill:ticket-worker' "$branch" "$worker_identity" "$landing_branch" "$text"
fi

# A new pane can still have canonical terminal input enabled. Long commands
# can overflow that input buffer, including the final Enter. Send only a path.
# mktemp creates a private file; /tmp keeps the command short and shell-neutral.
launcher=$(mktemp /tmp/pi-worker.XXXXXXXXXX) || exit
if ! {
  printf '%s\n' 'rm -- "$0" || exit'
  if [[ $orchestration_harness == opencode ]]; then
    printf '%s\n' 'unset OPENCODE_ORCHESTRATION_SESSION_ID OPENCODE_PARENT_ORCHESTRATION_SESSION_ID PI_ORCHESTRATION_SESSION_ID PI_PARENT_ORCHESTRATION_SESSION_ID'
    printf 'export OPENCODE_PARENT_ORCHESTRATION_SESSION_ID=%q\n' "$orchestration_session_id"
    printf 'exec opencode --standalone --prompt %q\n' "$prompt"
  else
    printf '%s\n' 'unset OPENCODE_ORCHESTRATION_SESSION_ID OPENCODE_PARENT_ORCHESTRATION_SESSION_ID PI_ORCHESTRATION_SESSION_ID PI_PARENT_ORCHESTRATION_SESSION_ID'
    printf 'export PI_PARENT_ORCHESTRATION_SESSION_ID=%q\n' "$orchestration_session_id"
    printf 'exec pi %q\n' "$prompt"
  fi
} > "$launcher"; then
  rm -f -- "$launcher"
  exit 1
fi

# The pane owns the file after dispatch. It removes the file before starting Pi.
command="bash $launcher"
if [[ $workspace_manager == herdr ]]; then
  herdr pane run "$pane_id" "$command"
  launch_status=$?
else
  tmux send-keys -l -t "$worker_identity:0" -- "$command" &&
    tmux send-keys -t "$worker_identity:0" Enter
  launch_status=$?
fi
if [[ $launch_status -ne 0 ]]; then
  rm -f -- "$launcher"
fi
exit "$launch_status"
