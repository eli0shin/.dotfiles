#!/usr/bin/env bash

# Queue a message for the Pi worker of one ticket. The worker's PR Watch
# steers it into the worker's running turn, or starts a turn if the worker
# is idle, so a correction does not wait for a long run to finish.

set -o pipefail

usage() {
  echo "Usage: message-worker [--repo <path>] <ticket-name> [<message>]" >&2
  echo "       printf '%s\\n' <message> | message-worker [--repo <path>] <ticket-name>" >&2
  exit 2
}

# Workers in different repos can share a branch name. --repo picks the repo;
# without it, the current directory's repo is preferred.
repo=""
if [[ ${1:-} == --repo ]]; then
  if [[ $# -lt 2 || -z $2 ]]; then
    usage
  fi
  repo=$2
  shift 2
fi

if [[ $# -ne 1 && $# -ne 2 ]]; then
  usage
fi

ticket=$1
if [[ $# -eq 2 ]]; then
  message=$2
elif [[ ! -t 0 ]]; then
  message=$(cat)
else
  usage
fi

if [[ -z ${PI_ORCHESTRATION_SESSION_ID:-} ]]; then
  echo "message-worker requires PI_ORCHESTRATION_SESSION_ID" >&2
  exit 2
fi

state_root=${PI_PR_WATCH_STATE_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/pi/pr-watch/orchestrations}

git_common_dir=$(git -C "${repo:-.}" rev-parse --path-format=absolute --git-common-dir 2>/dev/null)
if [[ -n $repo && -z $git_common_dir ]]; then
  echo "message-worker --repo requires a Git checkout: $repo" >&2
  exit 2
fi

python3 - "$state_root" "$PI_ORCHESTRATION_SESSION_ID" "$ticket" "$message" "$git_common_dir" "${repo:+explicit}" <<'PY'
import json
import os
import sys
import tempfile
import time
import uuid
from urllib.parse import quote

state_root, orchestration_id, ticket, text, git_common_dir, repo_mode = sys.argv[1:7]
text = text.strip()
if not text:
    raise SystemExit("message-worker requires a non-empty message")

# Match encodeURIComponent in pr-watch.ts.
encode = lambda value: quote(value, safe="-_.!~*'()")
directory = os.path.join(state_root, encode(orchestration_id))

workers = []
try:
    names = os.listdir(directory)
except FileNotFoundError:
    names = []
for name in names:
    if not name.endswith(".json"):
        continue
    try:
        with open(os.path.join(directory, name), encoding="utf-8") as handle:
            snapshot = json.load(handle)
    except (OSError, ValueError):
        continue
    if (
        isinstance(snapshot, dict)
        and snapshot.get("orchestrationId") == orchestration_id
        and snapshot.get("branch") == ticket
        and isinstance(snapshot.get("workerSessionId"), str)
        and isinstance(snapshot.get("revision"), (int, float))
    ):
        common = snapshot.get("gitCommonDir")
        workers.append((snapshot["revision"], snapshot["workerSessionId"], common if isinstance(common, str) else None))

if git_common_dir:
    in_repo = [worker for worker in workers if worker[2] == git_common_dir]
    if in_repo:
        workers = in_repo
    elif repo_mode:
        # Snapshots from workers started before repo tracking carry no repo.
        workers = [worker for worker in workers if worker[2] is None]

if not workers:
    where = f" in {os.path.dirname(git_common_dir)}" if repo_mode else ""
    raise SystemExit(f"no Pi worker found on branch {ticket}{where}")

repos = {worker[2] for worker in workers}
if len(repos) > 1:
    names = ", ".join(sorted(os.path.dirname(common) if common else "unknown" for common in repos))
    raise SystemExit(f"workers on branch {ticket} in several repos ({names}); pass --repo <path>")

# A respawned worker leaves the old session's snapshot behind. The live worker
# publishes a new revision on each start and settle, so the newest one wins.
worker_session_id = max(workers)[1]
inbox = os.path.join(directory, "inbox", encode(worker_session_id))
os.makedirs(inbox, mode=0o700, exist_ok=True)
message_id = f"{time.time_ns():020d}-{uuid.uuid4().hex}"
descriptor, temporary = tempfile.mkstemp(dir=inbox, prefix=f".{message_id}.", suffix=".tmp")
try:
    with os.fdopen(descriptor, "w", encoding="utf-8") as handle:
        json.dump({"version": 1, "id": message_id, "text": text}, handle)
        handle.write("\n")
    os.rename(temporary, os.path.join(inbox, f"{message_id}.json"))
except BaseException:
    os.unlink(temporary)
    raise

print(f"Queued message {message_id} for worker {ticket}; it steers the worker's current turn, or starts one if the worker is idle.")
PY
