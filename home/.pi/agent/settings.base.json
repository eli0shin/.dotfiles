{
  "theme": "dark-muted",
  "defaultThinkingLevel": "high",
  "quietStartup": true,
  "collapseChangelog": true,
  "doubleEscapeAction": "tree",
  "tuiMode": "fullscreen",
  "steeringMode": "all",
  "followUpMode": "all",
  "transport": "auto",
  "defaultProjectTrust": "always",
  "treeFilterMode": "no-tools",
  "terminal": {
    "hyperlinks": true
  },
  "compaction": {
    "enabled": true,
    "reserveTokens": 16384,
    "keepRecentTokens": 20000
  },
  "retry": {
    "enabled": true,
    "maxRetries": 3,
    "baseDelayMs": 2000,
    "provider": {
      "maxRetryDelayMs": 60000
    }
  },
  "packages": [
    "git:https://github.com/d-b/pi-exa.git@e06fb2fa6fb731b80a3a392939830cdd3267b2f4",
    "npm:@observal/pi-insights",
    {
      "source": "npm:@samfp/pi-essentials",
      "extensions": [
        "-dist/subagent.js",
        "-dist/compact-header.js",
        "-dist/context-pruner.js",
        "-dist/daily-log.js",
        "-dist/markdown-viewer.js",
        "-dist/auto-title.js",
        "-dist/auto-session-name.js"
      ]
    }
  ],
  "extensions": [
    "-extensions/permission-gate.ts",
    "-extensions/protected-paths.ts",
    "-extensions/provider-reliability/index.ts"
  ],
  "provider": {
    "openai": {
      "models": {
        "gpt-5.6-sol": {
          "options": {
            "text": {
              "verbosity": "low"
            }
          }
        }
      }
    }
  }
}
