# Ghostty Configuration
# Minimal config preserving iTerm2 preferences

# Font Configuration
font-family = "Operator Mono Medium"
font-size = 16

# Font rendering
font-synthetic-style = true

# Option key behavior (match iTerm2: Option as Alt)
macos-option-as-alt = true

# Colors: Arctic (VS Code Dark+), matched to Neovim
# Background and foreground
background = 1e1e1e
foreground = d4d4d4

# Normal colors (0-7)
palette = 0=#1e1e1e
palette = 1=#f44747
palette = 2=#6a9955
palette = 3=#d7ba7d
palette = 4=#569cd6
palette = 5=#c586c0
palette = 6=#4dc9b0
palette = 7=#dddddd

# Bright colors (8-15)
palette = 8=#808080
palette = 9=#f55757
palette = 10=#80ad6b
palette = 11=#e1cb9e
palette = 12=#6fabdc
palette = 13=#d6a9d2
palette = 14=#70d3bf
palette = 15=#ffffff

# Scrollback
scrollback-limit = 1000

# Terminal compatibility
term = xterm-256color

# Minimal visual preferences
window-padding-x = 0
window-padding-y = 0
window-padding-balance = true

# Cursor
cursor-style = block
cursor-style-blink = false

# Keybindings
keybind = cmd+enter=toggle_fullscreen

# Don't prompt before closing
confirm-close-surface = false
