# Keep personal configuration only; Herdr regenerates everything else.
/*
!/.gitignore
!/README.md
!/keys.json
!/settings.json
!/programs.json
!/program-icons/
/program-icons/*
!/program-icons/neovim.svg
!/shared.defaults.json
!/layouts/
/layouts/*
!/layouts/eli.json
!/layouts/eli.svg
!/themes/
/themes/*
!/themes/arctic.json
!/mods/
/mods/*
!/mods/navigator-status/
/mods/navigator-status/*
!/mods/navigator-status/main.js
!/mods/navigator-status/mod.json
!/mods/navigator-status/navigation.js
!/mods/navigator-status/agent-order.js
!/mods/navigator-status/preferences.js
!/mods/space-picker/
/mods/space-picker/*
!/mods/space-picker/main.js
!/mods/space-picker/mod.json
!/mods/eli-tabs/
/mods/eli-tabs/*
!/mods/eli-tabs/main.js
!/mods/eli-tabs/mod.json
!/mods/eli-tabs/names.js
!/mods/eli-agents/
/mods/eli-agents/*
!/mods/eli-agents/main.js
!/mods/eli-agents/mod.json
!/mods/eli-agents/names.js
!/mods/eli-spaces/
/mods/eli-spaces/*
!/mods/eli-spaces/main.js
!/mods/eli-spaces/mod.json
