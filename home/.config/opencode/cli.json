{
  "plugins": ["./plugins/pr-watch-tui.tsx"],
  "theme": {
    "name": "system",
    "mode": "system"
  },
  "keybinds": {
    "app.exit": "ctrl+c,<leader>q",
    "session.half.page.up": "ctrl+u",
    "session.half.page.down": "ctrl+d",
    "input.delete.to.line.start": "none",
    "input.delete": "delete,shift+delete"
  },
  "scroll": {
    "acceleration": true
  },
  "diffs": {
    "wrap": "word",
    "view": "auto",
    "tree": true,
    "single": false
  },
  "session": {
    "sidebar": "hide",
    "scrollbar": false,
    "thinking": "show",
    "markdown": "rendered",
    "grouping": "auto",
    "image_preview": false,
    "new_location": "launch"
  },
  "animations": false,
  "tabs": {
    "layout": "horizontal"
  },
  "mouse": true,
  "prompt": {
    "paste": "full",
    "image_preview": true
  },
  "attention": {
    "sound": false
  },
  "terminal": {
    "title": true
  },
  "debug": {
    "devtools": false,
    "turn_tokens": false
  }
}
