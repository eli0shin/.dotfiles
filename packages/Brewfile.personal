# Personal packages - not for work computers
# Install with: brew bundle --file=Brewfile.personal

tap "qmk/qmk", trusted: true
tap "osx-cross/arm", trusted: true

if OS.mac?
	mas "Developer", id: 640199958
	mas "Grocery", id: 1195676848
	mas "Keynote", id: 409183694
	mas "Microsoft Excel", id: 462058435
	mas "Microsoft PowerPoint", id: 462062816
	mas "Microsoft Word", id: 462054704
	mas "Pages", id: 409201541
	mas "Vimlike", id: 1584519802
	mas "Xcode", id: 497799835

	brew "jdtls"
	brew "openjdk"
	brew "qmk/qmk/qmk"
	brew "r"
	brew "render"
	brew "tailscale"

	cask "arduino-ide"
	cask "autodesk-fusion"
	cask "bambu-studio"
	cask "discord"
	cask "electron-fiddle"
	cask "firefox"
	cask "google-chrome"
	cask "keybase"
	cask "obs"
	cask "openscad"
	cask "orcaslicer"
	cask "postman"
	cask "qmk-toolbox"
	cask "raspberry-pi-imager"
	cask "slack"
	cask "streamlabs"
	cask "zoom"
end

brew "mosh"
brew "iperf3"

cask "bitwarden"
