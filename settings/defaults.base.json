{
  "NSGlobalDomain": {
    "AppleShowAllExtensions": true,
    "KeyRepeat": 2,
    "InitialKeyRepeat": 15,
    "ApplePressAndHoldEnabled": false,
    "AppleKeyboardUIMode": 3,
    "NSAutomaticSpellingCorrectionEnabled": true,
    "NSAutomaticCapitalizationEnabled": true,
    "NSAutomaticDashSubstitutionEnabled": true,
    "NSAutomaticPeriodSubstitutionEnabled": true,
    "NSAutomaticQuoteSubstitutionEnabled": true,
    "NSAutomaticTextCompletionEnabled": true,
    "NSNavPanelExpandedStateForSaveMode": true,
    "NSNavPanelExpandedStateForSaveMode2": true,
    "PMPrintingExpandedStateForPrint": true,
    "PMPrintingExpandedStateForPrint2": true,
    "NSDocumentSaveNewDocumentsToCloud": false,
    "NSAutomaticWindowAnimationsEnabled": false,
    "NSBrowserColumnAnimationSpeedMultiplier": 0,
    "NSDocumentRevisionsWindowTransformAnimation": false,
    "NSScrollAnimationEnabled": false,
    "NSToolbarFullScreenAnimationDuration": 0,
    "NSWindowResizeTime": 0.001,
    "QLPanelAnimationDuration": 0,
    "com.apple.SwiftUI.DisableSolarium": true,
    "_HIHideMenuBar": true
  },
  "com.apple.finder": {
    "FXPreferredViewStyle": "Nlsv",
    "ShowPathbar": true,
    "ShowStatusBar": true,
    "AppleShowAllFiles": true,
    "FXEnableExtensionChangeWarning": false,
    "_FXShowPosixPathInTitle": true,
    "FXDefaultSearchScope": "SCcf",
    "DisableAllAnimations": true
  },
  "com.apple.dock": {
    "tilesize": 37,
    "autohide": true,
    "mru-spaces": false,
    "orientation": "right",
    "show-recents": false,
    "minimize-to-application": true,
    "autohide-delay": 0,
    "autohide-time-modifier": 0,
    "expose-animation-duration": 0,
    "launchanim": false,
    "workspaces-auto-swoosh": false
  },
  "com.apple.screencapture": {
    "location": "~/Desktop/Screenshots",
    "type": "png",
    "disable-shadow": true
  },
  "com.apple.AppleMultitouchTrackpad": {
    "Clicking": true,
    "TrackpadThreeFingerDrag": true
  },
  "com.apple.driver.AppleBluetoothMultitouch.trackpad": {
    "Clicking": true,
    "TrackpadThreeFingerDrag": true
  },
  "com.apple.menuextra.clock": {
    "Show24Hour": true,
    "ShowSeconds": false
  },
  "com.apple.screensaver": {
    "askForPassword": true,
    "askForPasswordDelay": 0
  },
  "com.apple.CrashReporter": {
    "DialogType": "none"
  },
  "com.apple.Accessibility": {
    "ReduceMotionEnabled": true
  },
  "com.google.Chrome": {
    "NSUserKeyEquivalents": {
      "Open Location…": "^l"
    }
  }
}
